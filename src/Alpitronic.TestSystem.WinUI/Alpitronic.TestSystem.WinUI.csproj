<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Alpitronic.TestSystem.WinUI</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alpitronic.TestSystem.Domain\Alpitronic.TestSystem.Domain.csproj" />
    <ProjectReference Include="..\Alpitronic.TestSystem.Application\Alpitronic.TestSystem.Application.csproj" />
    <ProjectReference Include="..\Alpitronic.TestSystem.Infrastructure\Alpitronic.TestSystem.Infrastructure.csproj" />
    <ProjectReference Include="..\Alpitronic.TestSystem.Localization\Alpitronic.TestSystem.Localization.csproj" />
  </ItemGroup>
  <ItemGroup>
      <Content Include="Assets\translations.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
