<Page
    x:Class="Alpitronic.TestSystem.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="20" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Text="{Binding LanguageLabel}" />
                <ComboBox
                    Width="135"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding SupportedLanguages}"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                <TextBlock
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding SerialNumberLabel}" />
                <TextBox Width="220" Text="{Binding SerialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Margin="12,0,0,0"
                    Command="{Binding StartCommand}"
                    Content="{Binding StartSessionButtonLabel}" />
                <Button Command="{Binding CancelCommand}" Content="{Binding CancelButtonLabel}" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{Binding SimulateMissingMesTestCommand}" Content="{Binding MissingMesTestButtonLabel}" />
                <Button Command="{Binding SimulateDivergenceCommand}" Content="{Binding DivergentReadingsButtonLabel}" />
            </StackPanel>
            <Border
                Grid.Row="2"
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{Binding State}" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding Outcome}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Padding="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DutMeterTitle}" />
                        <TextBlock FontSize="22" Text="{Binding DutPower}" />
                        <TextBlock Text="{Binding DutEnergy}" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="1"
                    Padding="12"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{Binding HardwareMeterTitle}" />
                        <TextBlock FontSize="22" Text="{Binding HardwarePower}" />
                        <TextBlock Text="{Binding HardwareEnergy}" />
                    </StackPanel>
                </Border>
            </Grid>


            <Border
                Grid.Row="4"
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{Binding OutcomeDetailsTitle}" />

                    <TextBox
                        MinHeight="110"
                        MaxHeight="240"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        Text="{Binding OutcomeDetails}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="5"
                MinHeight="140"
                Padding="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="{Binding DiagnosticsTitle}" />
                    <ListView BorderThickness="0" ItemsSource="{Binding Diagnostics}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
